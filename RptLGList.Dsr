Attribute VB_Name = "RptLGList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
 
    If DataEnvironment1.rsLGList.State = 1 Then
       DataEnvironment1.rsLGList.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(frmLGTracking.SearchCriteria), "AND") = 0, "", Mid(Trim(frmLGTracking.SearchCriteria), InStr(1, ChkStr(frmLGTracking.SearchCriteria), "AND") + 3, Len(Trim(frmLGTracking.SearchCriteria))))
       DataEnvironment1.rsLGList.Filter = strsql
       DataEnvironment1.rsLGList.Sort = "LGNo"
        
End Sub
