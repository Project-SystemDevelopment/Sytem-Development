Attribute VB_Name = "RptCaseTrackList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
 
    If DataEnvironment1.rsCaseTrackList.State = 1 Then
       DataEnvironment1.rsCaseTrackList.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(FrmCaseTracking.CaseCriteria), "AND") = 0, "", Mid(Trim(FrmCaseTracking.CaseCriteria), InStr(1, ChkStr(FrmCaseTracking.CaseCriteria), "AND") + 3, Len(Trim(FrmCaseTracking.CaseCriteria))))
       DataEnvironment1.rsCaseTrackList.Filter = strsql
       DataEnvironment1.rsCaseTrackList.Sort = "CASNumber"
        
End Sub

