Attribute VB_Name = "RptBordxExcess"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
Dim strsql As String
    If DataEnvironment2.rsBordxExcess.state = 1 Then
       DataEnvironment2.rsBordxExcess.Requery
    End If
       
    strsql = IIf(InStr(1, ChkStr(FrmPrintBordxEx.BordxExCriteria), "AND") = 0, "", Mid(Trim(FrmPrintBordxEx.BordxExCriteria), InStr(1, ChkStr(FrmPrintBordxEx.BordxExCriteria), "AND") + 3, Len(Trim(FrmPrintBordxEx.BordxExCriteria))))
    DataEnvironment2.rsBordxExcess.Filter = strsql
    DataEnvironment2.rsBordxExcess.Sort = "BordxRefNo"
    
End Sub
