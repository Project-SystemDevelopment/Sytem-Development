Private Sub CmdBack_Click()
    Frame10.Visible = True
    Frame4.Visible = True
    Frame3.Visible = True
    Frame6.Visible = True
            
    If Click1 = True Then
        Frame2.Visible = False
        Frame5.Visible = True
    ElseIf Click2 = True Then
        Frame5.Visible = False
