            Call CheckDate
        ElseIf Option19.value = True And Option35.value = True Then
            Call ICListing
        ElseIf Option20.value = True And Option34.value = True Then
            Call BordxDateListing
        ElseIf Option25.value = True And Option35.value = True Then
            Call GeneralListing3
