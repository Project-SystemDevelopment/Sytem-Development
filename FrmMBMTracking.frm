    sql2 = " GROUP BY PAYCode, HLTCode, INSCode, PrinAGECode ORDER BY PAYCode, HLTCode, INSCode, PrinAGECode "
    
    If AgeBand = "" Then
        sql3 = " AND PAYCode = '" & Trim(Payor) & "' AND HLTCode = '" & Trim(HltType) & "' AND INSCode = '" & Trim(InsType) & "' AND (PrinAGECode = '' OR PrinAGECode IS NULL)"
