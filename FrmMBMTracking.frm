                      ElseIf MBM!MBMStatus = "C" Then
                          strName = Trim(MBM!MBMName) & " (Cancelled)"
                      ElseIf MBM!MBMStatus = "D" Then
                          strName = Trim(MBM!MBMName) & " (Deleted)"
                      Else
                         strName = Trim(MBM!MBMName)
                      End If
                      
                      If Trim(Mid(CboMbmType, 1, 1)) = "P" Then
                         .SubItems(1) = "00"
                      ElseIf Trim(Mid(CboMbmType, 1, 1)) = "Q" Or Trim(Mid(CboMbmType, 1, 1)) = "C" Then
                         .SubItems(1) = MBM!MBMCCoverID
                      Else
                        .SubItems(1) = IIf(Len(MBM!MBMCCoverID) <> "00", MBM!MBMCCoverID, "00")
                      End If
                            
                        If Trim(MBM!MBMICBcPp) <> "" Then
                            .SubItems(2) = Trim(MBM!MBMICBcPp)
                        End If
                        
                        .SubItems(3) = strName
                        
                        If Len(MBM!MBMPayorEffDate) Then
                          .SubItems(4) = Format(MBM!MBMPayorEffDate, "dd/mm/yyyy")
                        End If
                        
                        If Len(MBM!MBMPayorEXPDate) Then
                          .SubItems(5) = Format(MBM!MBMPayorEXPDate, "dd/mm/yyyy")
                        End If
                        
                        If Len(MBM!MBMFirstJoinedDate) Then
                          .SubItems(6) = Format(MBM!MBMFirstJoinedDate, "dd/mm/yyyy")
                        End If
                        
                        If Len(MBM!MBMInstallment) Then
                          .SubItems(7) = MBM!MBMInstallment
                        End If
                        
                        If Len(MBM!MBMPolicyYear) Then
                          .SubItems(8) = MBM!MBMPolicyYear
                        End If
                        
                        If Len(MBM!MBMRenewFlag) Then
                          .SubItems(9) = MBM!MBMRenewFlag
                        End If
                        
                        If Len(MBM!MBMTakeOver) Then
                          .SubItems(10) = MBM!MBMTakeOver
                        End If
                
                  End With
                  
                  If ChkStr(MBM!MBMMemberType) = "P" Or ChkStr(MBM!MBMMemberType) = "Q" Then
                     TotalPrincipalCount = TotalPrincipalCount + 1
                     lblTotalPrincipalCount = TotalPrincipalCount
                     lblCurrent = lblTotalPrincipalCount
                     
                  ElseIf ChkStr(MBM!MBMMemberType) = "C" Or ChkStr(MBM!MBMMemberType) = "S" Then
                     totalSuppCount = totalSuppCount + 1
                     lbltotalSuppCount = totalSuppCount
                     lblCurrent = lbltotalSuppCount
                  Else
                    lblCurrent = lblCurrent + 1
                  End If
                 End If
                 MBM.MoveNext
                 DoEvents
                 
                 If intExit = 1 Then
                     Check = False
                     Exit Do
                 End If
               Loop
        Loop Until Check = False
        Do
               If InStr(1, CboMbmType, "-") = 0 Then
                    tempCoverID = ""
                    tempMBMNumber = ""
                    Do Until MBMSupplementary.EOF
                     goThru = True
                     
                    If Trim(tempMBMNumber) = Trim(MBMSupplementary!MBMNumber) And _
                        Trim(tempCoverID) = Trim(MBMSupplementary!MBMCCoverID) Then
                        goThru = False
                    End If
                     
                     
                     If goThru = True Then
                        tempCoverID = MBMSupplementary!MBMCCoverID
                        tempMBMNumber = MBMSupplementary!MBMNumber
                        Set MEMList = lstMBMInquiryList.listitems.Add(, , MBMSupplementary!MBMNumber)
                        With MEMList
