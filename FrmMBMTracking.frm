      End If
      If ChkRel.value = 1 Then
          strCriteria = strCriteria + " AND (RELCode Is null OR RELCode = '')"
      End If
      
      If Len(Trim(Mid(cboDataStatus, 1, 1))) Then
          strCriteria = strCriteria & " AND MBMDataStatus = '" & Trim(Mid(cboDataStatus, 1, InStr(1, cboDataStatus, "-") - 1)) & "' "
      End If
