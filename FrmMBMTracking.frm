          strCriteria = strCriteria & "AND HLTCode= '" & Mid(cboHLTCode, 1, 1) & "' "
      End If
      If ChkHltType.value = 1 Then
          strCriteria = strCriteria & " AND (HLTCode IS NULL OR HLTCode = '')"
      End If
      
      If Len(Trim(Mid(cboINSCode, 1, 1))) Then
          strCriteria = strCriteria & " AND  INSCode = '" & Trim(Mid(cboINSCode, 1, 1)) & "'"
      End If
      If ChkInsType.value = 1 Then
