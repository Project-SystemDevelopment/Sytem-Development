'=============== Start Load Insured Type ===========================

Private Sub LoadInsuredType()
Dim StrSql As String
Dim HLTCode As String
Dim INS As New ADODB.Recordset
Dim cmd As New ADODB.Command
    
    cboINSCode.Clear
    Set cmd.ActiveConnection = medixmasterconn
    cmd.CommandText = "SearchINS"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 15
    INS.CursorLocation = adUseClient
    INS.CursorType = adOpenForwardOnly
    INS.CacheSize = 100
    Set INS = cmd.Execute
    
    Do Until INS.EOF
        With INS
            cboINSCode.AddItem !INSCode & " - " & !INSDescription
            INS.MoveNext
        End With
    Loop
    INS.Close
    Set INS = Nothing
End Sub
'=============== End Load Insured Type ===========================

'=============== Start Load Payor  ===========================

Private Sub LoadPayor(Optional HLTCode As String)
Dim PAY As New ADODB.Recordset
Dim StrAppend As String
Dim cmd As New ADODB.Command
Dim prm1 As New ADODB.Parameter

    StrAppend = StrAppend & "And HLTCOde = '" & Mid(Trim(cboHLTCode), 1, 1) & "'"
    Set cmd.ActiveConnection = medixmasterconn
    cmd.CommandText = "SearchPayorHLTType"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 15
    Set prm1 = cmd.CreateParameter("strAppend", adVarChar, adParamInput, 255, StrAppend)
    cmd.Parameters.Append prm1
    PAY.CursorLocation = adUseClient
    PAY.CursorType = adOpenForwardOnly
    PAY.CacheSize = 100
    Set PAY = cmd.Execute
    
    cboPayorCode.Clear
    Do Until PAY.EOF
        With PAY
            cboPayorCode.AddItem !PAYCode & " - " & !PAYCompanyName
            PAY.MoveNext
        End With
    Loop
    
    PAY.Close
    Set PAY = Nothing
    
End Sub
'=============== End Load Payor ===================================

