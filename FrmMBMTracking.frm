Private Sub MCOInvoiceSum(Optional StrAppend As String)
Dim rst2 As New ADODB.Recordset
Dim rst3 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim sql3 As String
Dim sql4 As String

Total = 0
TotalP = 0
TotalS = 0
TotalS1 = 0
TotalMCO = 0
TotalSMCO = 0
        
lstMBMInquiryList.listitems.Clear

If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
        
    sql = " SELECT PAYCode, MBMInvoiceNo, MBMInvoiceDate, COUNT(MBMNumber) AS TotalP, " & _
          " SUM(MBMMCOFee) AS MCOGross From VIEW_MBM_Search2 Where 0 = 0 "
    
    sql2 = " GROUP BY PAYCode, MBMInvoiceNo, MBMInvoiceDate ORDER BY PAYCode "
    
        
    If Len(Trim(StrAppend)) Then
        sql = sql + StrAppend + sql2
    Else
        sql = sql + sql2
    End If
    
    rst2.Open sql, medixmasterconn, adOpenForwardOnly, adLockBatchOptimistic
    
    Do
        Do Until rst2.EOF
                        
            With rst2
    
                Set Record = lstMBMInquiryList.listitems.Add(, , rst2!PAYCode)
                Payor = rst2!PAYCode
                                
                If Len(rst2!MBMInvoiceNo) Then
                   Record.SubItems(1) = Trim(rst2!MBMInvoiceNo)
                   Invoice = Trim(rst2!MBMInvoiceNo)
                ElseIf rst2!MBMInvoiceNo = "" Then
                    Record.SubItems(1) = "Empty"
                    Invoice = ""
                Else
                    Record.SubItems(1) = "Empty"
                    Invoice = "NULL"
                End If
                             
                If Len(rst2!MBMInvoiceDate) Then
                   Record.SubItems(2) = Format(rst2!MBMInvoiceDate, "dd/mm/yyyy")
                   InvDate = Trim(rst2!MBMInvoiceDate)
                ElseIf rst2!MBMInvoiceDate = Null Then
                    Record.SubItems(2) = "Empty"
                    InvDate = ""
                Else
                    Record.SubItems(2) = "Empty"
                    InvDate = "NULL"
                End If
                
                If Len(rst2!TotalP) Then
                   Record.SubItems(3) = rst2!TotalP
                End If
                
                If Len(rst2!MCOGross) Then
                   Record.SubItems(5) = Format(rst2!MCOGross, "#,##0.00")
                Else
                   Record.SubItems(5) = "0.00"
                End If
                
                If Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountSuppRecordsMCOInvoice(StrAppend)
                End If
                
                If Len(TotalS) Then
                   Record.SubItems(4) = TotalS
                End If
                
                'If Len(TotalSMCO) Then
                   'Record.SubItems(6) = Format(totasMCO, "#,##0.00")
                'Else
