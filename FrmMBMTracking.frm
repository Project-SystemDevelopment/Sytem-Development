                            End If
                            
                            If Mid(ChkStr(CboMbmType), 1, 1) = "P" Then
                              .SubItems(1) = 0
                            Else
                              .SubItems(1) = MBMSupplementary!MBMCCoverID
                            End If
                            
                            If Trim(MBMSupplementary!MBMICBcPp) <> "" Then
                                .SubItems(2) = Trim(MBMSupplementary!MBMICBcPp)
                            End If
                            
                            .SubItems(3) = strName
                            
                            If Len(MBMSupplementary!MBMPayorEffDate) Then
                              .SubItems(4) = Format(MBMSupplementary!MBMPayorEffDate, "dd/mm/yyyy")
                            End If
                            
                            If Len(MBMSupplementary!MBMPayorEXPDate) Then
                              .SubItems(5) = Format(MBMSupplementary!MBMPayorEXPDate, "dd/mm/yyyy")
                            End If
                            
                            If Len(MBMSupplementary!MBMFirstJoinedDate) Then
                              .SubItems(6) = Format(MBMSupplementary!MBMFirstJoinedDate, "dd/mm/yyyy")
                            End If
                            
                            If Len(MBMSupplementary!MBMInstallment) Then
                              .SubItems(7) = MBMSupplementary!MBMInstallment
                            End If
                            
                            If Len(MBMSupplementary!MBMPolicyYear) Then
                              .SubItems(8) = MBMSupplementary!MBMPolicyYear
                            End If
                            
                            If Len(MBMSupplementary!MBMRenewFlag) Then
                              .SubItems(9) = MBMSupplementary!MBMRenewFlag
                            End If
                            
                            If Len(MBMSupplementary!MBMTakeOver) Then
                              .SubItems(10) = MBMSupplementary!MBMTakeOver
                            End If
                            
                        End With
                        totalSuppCount = totalSuppCount + 1
                        lbltotalSuppCount = totalSuppCount
                        lblCurrent = CDbl(TotalPrincipalCount) + CDbl(totalSuppCount)
                           
                     End If
                     MBMSupplementary.MoveNext
                    
                     DoEvents
                     
                     If intExit = 1 Then
                        Check = False
                        Exit Do
                     End If
                    Loop
                End If
         Loop Until Check = False
         intExit = 0
        MBM.Close
        Set MBM = Nothing
        CmdClear.Enabled = True
        If Len(Trim(CboMbmType)) = 0 Then
            MBMSupplementary.Close
            Set MBMSupplementary = Nothing
        End If
    End If
    
    Screen.MousePointer = vbDefault
    cmdExit.Enabled = True
    CmdClear.Enabled = True
    CmdPrintFile.Enabled = True
    If lstMBMInquiryList.listitems.count = 0 Then
        MsgBox "Sorry, No Record Found", vbOKOnly + vbCritical, DialogBoxTitle
        cmdExit.Enabled = True
        CmdClear.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    'End If
ErrList:
    Screen.MousePointer = vbDefault

End Sub
