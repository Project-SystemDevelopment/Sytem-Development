Private Sub BranchByAgent(Optional StrAppend As String)
Dim rst As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim TotalPolicy As String
Dim TotalPremium As String
Dim TotalNoClaim As String
Dim TotalClaimPaid As String
Dim TotalPolicyClaim As String
Dim TotalPremClaimPaid As String
    
TotalPolicyClaim = 0
TotalPremClaimPaid = 0
TotalNoClaim = 0
TotalClaimPaid = 0
TotalPremium = 0
TotalPolicy = 0
Total = 0
TotalP = 0
TotalPrem = 0
Branch = ""
Agent = ""
TotalF = 0
TotalFamPrem = 0
TotalFS = 0
TotalFSPremium = 0
TotalH = 0
TotalHPrem = 0
TotalHS = 0
TotalHSPremium = 0
TotalInd = 0
TotalIndPrem = 0
TotalGrpInd = 0
TotalGPrem = 0
NoClaimInd = 0
NoClaimPaidInd = 0
NoClaimFam = 0
NoClaimPaidFam = 0
NoClaimGrpFam = 0
NoClaimPaidGrpFam = 0
NoClaimGrpInd = 0
NoClaimPaidGrpInd = 0
lblCurrent = 0
            
lstMBMInquiryList.listitems.Clear
    
    If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
        sql = " SELECT BRNCode, MBMAgentCode From VIEW_MBM_Search2 Where 0 = 0 "
    ElseIf Mid(ChkStr(CboMbmType), 1, 1) = "S" Then
        sql = " SELECT BRNCode, MBMAgentCode From View_MBM_Supplementary2 Where 0 = 0 "
    End If
                    
    sql2 = " GROUP BY BRNCode, MBMAgentCode ORDER BY BRNCode, MBMAgentCode "
    
        
    If Len(Trim(StrAppend)) Then
        sql = sql + StrAppend + sql2
    Else
        sql = sql + sql2
    End If
    
    rst.Open sql, medixmasterconn, adOpenForwardOnly, adLockBatchOptimistic
    
    
    Do
        Do Until rst.EOF
                                                
                If Len(rst!BRNCode) Then
                    Set Record = lstMBMInquiryList.listitems.Add(, , Trim(rst!BRNCode))
                    Branch = Trim(rst!BRNCode)
                Else
                    Set Record = lstMBMInquiryList.listitems.Add(, , "Empty")
                    Branch = ""
                End If
                                
                If Len(rst!MBMAgentCode) Then
                    Record.SubItems(1) = Trim(rst!MBMAgentCode)
                    Agent = Trim(rst!MBMAgentCode)
                Else
                    Record.SubItems(1) = "Empty"
                    Agent = ""
                End If
                
                '==========Count Individual Record ==============
                If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountIndRecordsBranch(StrAppend)
                End If
                Record.SubItems(2) = TotalInd
                Record.SubItems(7) = Format(TotalIndPrem, "#,##0.00")
                '==========Count Individual Record ==============
                
                '==========Count Family Record ==============
                If Mid(ChkStr(CboMbmType), 1, 1) = "P" Then
                    Call CountFamilyRecordsBranch(StrAppend)
                ElseIf Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountFamilyRecordsBranch(StrAppend)
                    Call CountFamilyRecordsBranchSupp(StrAppend)
                ElseIf Mid(ChkStr(CboMbmType), 1, 1) = "S" Then
                    Call CountFamilyRecordsBranchSupp(StrAppend)
                End If
                Record.SubItems(3) = CDbl(TotalF) + CDbl(TotalFS)
                Record.SubItems(8) = Format(CDbl(TotalFamPrem) + CDbl(TotalFSPremium), "#,##0.00")
                '==========Count Family Record ==============
                
                '==========Count Group Family Record ==============
                If Mid(ChkStr(CboMbmType), 1, 1) = "P" Then
                    Call CountGrpFamilyRecordsBranch(StrAppend)
                ElseIf Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountGrpFamilyRecordsBranch(StrAppend)
                    Call CountGrpFamilyRecordsBranchSupp(StrAppend)
                ElseIf Mid(ChkStr(CboMbmType), 1, 1) = "S" Then
                    Call CountGrpFamilyRecordsBranchSupp(StrAppend)
                End If
                Record.SubItems(4) = CDbl(TotalH) + CDbl(TotalHS)
                Record.SubItems(9) = Format(CDbl(TotalHPrem) + CDbl(TotalHSPremium), "#,##0.00")
                '==========Count Group Family Record ==============
                
                '==========Count Group Individual Record ==============
                If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountGrpIndRecordsBranch(StrAppend)
                End If
                Record.SubItems(5) = TotalGrpInd
                Record.SubItems(10) = Format(TotalGPrem, "#,##0.00")
                '==========Count Group Individual Record ==============
                
                TotalPolicy = (CDbl(Record.SubItems(2)) + CDbl(Record.SubItems(3)) + CDbl(Record.SubItems(4)) + CDbl(Record.SubItems(5)))
                Record.SubItems(6) = TotalPolicy
                
                TotalPrem = (CDbl(Record.SubItems(7)) + CDbl(Record.SubItems(8)) + CDbl(Record.SubItems(9)) + CDbl(Record.SubItems(10)))
                Record.SubItems(11) = Format(TotalPrem, "#,##0.00")
                
                TotalPremium = TotalPremium + CDbl(Record.SubItems(11))
                LblPrem = Format(TotalPremium, "#,##0.00")
                
                '==========Count No of Claim Individual Record ==============
                If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountClaimIndRecordsBranch(StrAppend)
                End If
                
                Record.SubItems(12) = NoClaimInd
                Record.SubItems(17) = Format(NoClaimPaidInd, "#,##0.00")
                
                '==========Count No of Claim Individual Record ==============
                
                '==========Count No of Claim Family Record ==============
                Call CountClaimFamilyRecordsBranch(StrAppend)
                
                Record.SubItems(13) = NoClaimFam
                Record.SubItems(18) = Format(NoClaimPaidFam, "#,##0.00")
                
                '==========Count No of Claim Family Record ==============
                
                '==========Count No of Claim Grp Family Record ==============
                Call CountClaimGrpFamilyRecordsBranch(StrAppend)
                
                Record.SubItems(14) = NoClaimGrpFam
                Record.SubItems(19) = Format(NoClaimPaidGrpFam, "#,##0.00")
                
                '==========Count No of Claim Grp Family Record ==============
                
                '==========Count No of Claim Grp Ind Record ==============
                If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountClaimGrpIndRecordsBranch(StrAppend)
                End If
                
                Record.SubItems(15) = NoClaimGrpInd
                Record.SubItems(20) = Format(NoClaimPaidGrpInd, "#,##0.00")
                
                '==========Count No of Claim Grp Ind Record ==============
                
                TotalNoClaim = (CDbl(Record.SubItems(12)) + CDbl(Record.SubItems(13)) + CDbl(Record.SubItems(14)) + CDbl(Record.SubItems(15)))
                Record.SubItems(16) = TotalNoClaim
                
                TotalClaimPaid = (CDbl(Record.SubItems(17)) + CDbl(Record.SubItems(18)) + CDbl(Record.SubItems(19)) + CDbl(Record.SubItems(20)))
                Record.SubItems(21) = Format(TotalClaimPaid, "#,##0.00")
                
                TotalPolicyClaim = Round(TotalNoClaim / TotalPolicy, 0)
                Record.SubItems(22) = TotalPolicyClaim
                
                If CDbl(TotalClaimPaid) And CDbl(TotalPrem) Then
                    TotalPreClaimPaid = Format(Round(CDbl(TotalClaimPaid) / CDbl(TotalPrem), 2), "#,##0.00")
                    Record.SubItems(23) = TotalPreClaimPaid
                Else
                    Record.SubItems(23) = "0.00"
                End If
            
            lblCurrent = lblCurrent + 1
                        
            rst.MoveNext
            DoEvents
        
            If intExit = 1 Then
                Check = False
                Exit Do
            End If
            Loop
    Loop Until Check = False
    intExit = 0
