Private Sub DataReport_Initialize()
    Dim strsql As String
    
           
    'If DataEnvironment2.rsDebitCreditList.State = 1 Then
     '  DataEnvironment2.rsDebitCreditList.Requery
    'End If
        
               
        strsql = IIf(InStr(1, ChkStr(FrmDrCrTracking.DNCNCriteria), "AND") = 0, "", Mid(Trim(FrmDrCrTracking.DNCNCriteria), InStr(1, ChkStr(FrmDrCrTracking.DNCNCriteria), "AND") + 3, Len(Trim(FrmDrCrTracking.DNCNCriteria))))
        DataEnvironment2.rsDebitCreditList.Filter = strsql
        'DataEnvironment2.rsDebitCreditList.Sort = "DebitCreditRefNo"
        
End Sub

