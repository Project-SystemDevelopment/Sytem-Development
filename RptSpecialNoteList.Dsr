Attribute VB_Name = "RptSpecialNoteList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    If DataEnvironment1.rsPlnList.state = 1 Then
       DataEnvironment1.rsPlnList.Requery
    End If
    StrSql = IIf(InStr(1, ChkStr(frmMaintenancePlan.SpecialCriteria), "AND") = 0, "", Mid(Trim(frmMaintenancePlan.SpecialCriteria), InStr(1, ChkStr(frmMaintenancePlan.SpecialCriteria), "AND") + 3, Len(Trim(frmMaintenancePlan.SpecialCriteria))))
    DataEnvironment1.rsPlnList.Filter = ""
    DataEnvironment1.rsPlnList.Sort = ""
    DataEnvironment1.rsPlnList.Filter = StrSql
    If DataEnvironment1.rsPlnList.state = 1 Then
        If DataEnvironment1.rsPlnList.recordCount > 1 Then
         DataEnvironment1.rsPlnList.Sort = "PLNCode"
         
        End If
    End If
End Sub

