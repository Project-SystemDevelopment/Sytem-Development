Attribute VB_Name = "RptPaymentHOS"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
Dim strsql As String

    If DataEnvironment3.rsPaymentHOSTracking.State = 1 Then
       DataEnvironment3.rsPaymentHOSTracking.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(FrmPaymentTracking.PaymentTrackingCriteria), "AND") = 0, "", Mid(Trim(FrmPaymentTracking.PaymentTrackingCriteria), InStr(1, ChkStr(FrmPaymentTracking.PaymentTrackingCriteria), "AND") + 3, Len(Trim(FrmPaymentTracking.PaymentTrackingCriteria))))
    'If DataEnvironment3.rsPaymentHOSTracking.recordCount > 0 Then
        DataEnvironment3.rsPaymentHOSTracking.Filter = strsql
        DataEnvironment3.rsPaymentHOSTracking.Sort = "PVHOSNo"
    'End If
End Sub

