Attribute VB_Name = "RptCATList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsSuspendList.state = 1 Then
       DataEnvironment1.rsSuspendList.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(frmSuspensionDetail.CATCriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceGeneral.AGTCriteria), InStr(1, ChkStr(frmMaintenanceGeneral.AGTCriteria), "AND") + 3, Len(Trim(frmMaintenanceGeneral.AGTCriteria))))
       DataEnvironment1.rsSuspendList.Filter = strsql
       DataEnvironment1.rsSuspendList.Sort = "SuspensionCode"
End Sub

