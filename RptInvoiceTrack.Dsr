Attribute VB_Name = "RptInvoiceTrack"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
Dim strsql As String
    If DataEnvironment2.rsInvoiceList.State = 1 Then
       DataEnvironment2.rsInvoiceList.Requery
    End If
        
    strsql = IIf(InStr(1, ChkStr(FrmInvoiceTracking2.searchCriteria), "AND") = 0, "", Mid(Trim(FrmInvoiceTracking2.searchCriteria), InStr(1, ChkStr(FrmInvoiceTracking2.searchCriteria), "AND") + 3, Len(Trim(FrmInvoiceTracking2.searchCriteria))))
    DataEnvironment2.rsInvoiceList.Filter = strsql
    DataEnvironment2.rsInvoiceList.Sort = "CASNumber"
End Sub

