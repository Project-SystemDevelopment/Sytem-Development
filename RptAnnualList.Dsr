Attribute VB_Name = "RptAnnualList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()

    If DataEnvironment1.rsAnnualList.State = 1 Then
       DataEnvironment1.rsAnnualList.Requery
    End If
    strsql = IIf(InStr(1, ChkStr(frmMaintenancePlan.AnnualCriteria), "AND") = 0, "", Mid(Trim(frmMaintenancePlan.AnnualCriteria), InStr(1, ChkStr(frmMaintenancePlan.AnnualCriteria), "AND") + 3, Len(Trim(frmMaintenancePlan.AnnualCriteria))))
    DataEnvironment1.rsAnnualList.Filter = ""
    DataEnvironment1.rsAnnualList.Sort = ""
    DataEnvironment1.rsAnnualList.Filter = strsql
    If DataEnvironment1.rsAnnualList.State = 1 Then
        If DataEnvironment1.rsAnnualList.recordCount > 1 Then
         DataEnvironment1.rsAnnualList.Sort = "PLNCode"
        End If
     End If
    
    'If DataEnvironment1.rsAnnualList.State = 1 Then
        'DataEnvironment1.rsAnnualList.Requery
    'End If
        'strsql = IIf(InStr(1, ChkStr(frmMaintenancePlan.AnnualCriteria), "AND") = 0, "", Mid(Trim(frmMaintenancePlan.AnnualCriteria), InStr(1, ChkStr(frmMaintenancePlan.AnnualCriteria), "AND") + 3, Len(Trim(frmMaintenancePlan.AnnualCriteria))))
        'DataEnvironment1.rsAnnualList.Filter = strsql
        'DataEnvironment1.rsAnnualList.Sort = "PLNCode"
        
End Sub

