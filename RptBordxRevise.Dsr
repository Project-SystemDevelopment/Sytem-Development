Attribute VB_Name = "RptBordxRevise"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
Dim strsql As String
    If DataEnvironment2.rsWksTrackingList.State = 1 Then
       DataEnvironment2.rsWksTrackingList.Requery
    End If
    'strsql = IIf(InStr(1, ChkStr(FrmBordxRevise.SearchCriteria), "AND") = 0, "", Mid(Trim(FrmBordxRevise.SearchCriteria), InStr(1, ChkStr(FrmBordxRevise.SearchCriteria), "AND") + 3, Len(Trim(FrmBordxRevise.SearchCriteria))))
    
    strsql = IIf(InStr(1, ChkStr(FrmBordxRevise.lblSearhCriteria), "AND") = 0, "", Mid(Trim(FrmBordxRevise.lblSearhCriteria), InStr(1, ChkStr(FrmBordxRevise.lblSearhCriteria), "AND") + 3, Len(Trim(FrmBordxRevise.lblSearhCriteria))))
    DataEnvironment2.rsWksTrackingList.Filter = strsql
    DataEnvironment2.rsWksTrackingList.Sort = "CASNumber"
End Sub
