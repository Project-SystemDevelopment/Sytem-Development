Private Sub DataReport_Initialize()
    If Trim(frmMaintenancePlan.HLTCriteria) <> "" Then
        strsql = IIf(InStr(1, frmMaintenancePlan.HLTCriteria, "d") = 0, "0=0", Mid(frmMaintenancePlan.HLTCriteria, InStr(1, frmMaintenancePlan.HLTCriteria, "d") + 1, Len(frmMaintenancePlan.HLTCriteria)))
        DataEnvironment1.rsHltList.Filter = strsql
    End If
End Sub
