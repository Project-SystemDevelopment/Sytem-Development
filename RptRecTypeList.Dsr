Private Sub DataReport_Initialize()
    
    If DataEnvironment4.rsRecTypeList.state = 1 Then
       DataEnvironment4.rsRecTypeList.Requery
    End If
       StrSql = IIf(InStr(1, ChkStr(frmMaintenanceOthers.RecTypeCriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceOthers.RecTypeCriteria), InStr(1, ChkStr(frmMaintenanceOthers.RecTypeCriteria), "AND") + 3, Len(Trim(frmMaintenanceOthers.RecTypeCriteria))))
       DataEnvironment4.rsRecTypeList.Filter = StrSql
       DataEnvironment4.rsRecTypeList.Sort = "RecTypeCode"
End Sub

