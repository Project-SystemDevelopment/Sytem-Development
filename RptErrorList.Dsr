'Private Sub DataReport_Initialize()
'Dim strsql As String
    'If DataEnvironment1.rsErrList.state = 1 Then
       'DataEnvironment1.rsErrList.Requery
    'End If
        
    'strsql = IIf(InStr(1, ChkStr(frmEndorsement.searchCriteria), "AND") = 0, "", Mid(Trim(frmEndorsement.searchCriteria), InStr(1, ChkStr(frmEndorsement.searchCriteria), "AND") + 3, Len(Trim(frmEndorsement.searchCriteria))))
    'DataEnvironment1.rsErrList.Filter = strsql
    'DataEnvironment1.rsErrList.Sort = "ERRRecordLine"
'End Sub
