Attribute VB_Name = "RptPrmList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    If DataEnvironment1.rsPrmList.State = 1 Then
       DataEnvironment1.rsPrmList.Requery
    End If
    strsql = IIf(InStr(1, ChkStr(frmMaintenancePlan.PRMCriteria), "AND") = 0, "", Mid(Trim(frmMaintenancePlan.PRMCriteria), InStr(1, ChkStr(frmMaintenancePlan.PRMCriteria), "AND") + 3, Len(Trim(frmMaintenancePlan.PRMCriteria))))
    DataEnvironment1.rsPrmList.Filter = ""
    DataEnvironment1.rsPrmList.Sort = ""
    DataEnvironment1.rsPrmList.Filter = strsql
    If DataEnvironment1.rsPrmList.State = 1 Then
        If DataEnvironment1.rsPrmList.recordCount > 1 Then
         DataEnvironment1.rsPrmList.Sort = "INSCode"
        End If
     End If
End Sub


