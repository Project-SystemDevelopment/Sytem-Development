Private Sub CboProductCat_KeyPress(KeyAscii As Integer)
Dim NewText As String
Dim ValidCount As Integer
Dim ValidValue As String
Dim i As Integer

    If KeyAscii >= 32 And KeyAscii <> 127 Then
    'NewText = LCase(Left(cboPrincipalType.Text, cboPrincipalType.SelStart) + Chr(KeyAscii) + Mid(cboPrincipalType.Text, cboPrincipalType.SelStart + cboPrincipalType.SelLength + 1))
 
    ValidCount = 0
    ValidValue = ""
 
    For i = 0 To CboProductCat.ListCount - 1
 
        If NewText = LCase(Left(CboProductCat.List(i), Len(NewText))) Then
                ValidCount = ValidCount + 1
                ValidValue = CboProductCat.List(i)
        End If
        Next
        If ValidCount <= 1 Then KeyAscii = 0
            If ValidCount = 1 Then
                CboProductCat.Text = ValidValue
                CboProductCat.SelStart = 0
                CboProductCat.SelLength = Len(ValidValue)
            End If
        End If
End Sub

