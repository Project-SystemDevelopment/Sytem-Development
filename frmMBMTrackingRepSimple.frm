    rst2.CacheSize = 100
    Set rst2 = cmd.Execute
    
    'sql = " SELECT PAYCode, SUM(MBMMCOFee) AS MBMMCOFee, SUM(MBMBasicMCO) AS MBMBasicMCO, " & _
          " SUM(MBMPayorMCOGross) AS MBMPayorMCOGross, SUM(MBMPayorMCONet) AS MBMPayorMCONet, " & _
