Private Sub RegMonthPayor(Optional strAppend As String)
Dim rst2 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim cmd As New ADODB.Command
Dim Prm1 As New ADODB.Parameter
Dim Prm2 As New ADODB.Parameter
Dim strAppendCase As String

Total = 0
TotalP = 0
TotalS = 0
TotalS1 = 0
TotalMCO = 0
TotalPrem = 0
TotalSMCO = 0
TotalSPrem = 0
TotalAccess = 0
Payor = ""
Month = ""
Year = ""
    
lstMBMInquiryList.listitems.Clear

If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
          
    strAppendCase = "125"
            
    Set cmd.ActiveConnection = medixneptuneconn
    cmd.CommandText = "MBMTrackingSimple"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 300
    Set Prm1 = cmd.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, strAppend)
    cmd.Parameters.Append Prm1
    Set Prm2 = cmd.CreateParameter("strAppendCase", adVarChar, adParamInput, 255, strAppendCase)
    cmd.Parameters.Append Prm2
    rst2.CursorLocation = adUseClient
    rst2.CursorType = adOpenForwardOnly
    rst2.CacheSize = 100
    Set rst2 = cmd.Execute
    
    'sql = " SELECT PAYCode, MONTH(MBMValueDate) AS Month, " & _
          " YEAR(MBMValueDate) AS Year, COUNT(MBMNumber) AS TotalP, " & _
          " SUM(MBMPremium) AS PremiumGross, SUM(MBMMCOFee) AS MCOGross, " & _
          " SUM(MBMAccessFee) AS EAFee FROM VIEW_MBM_Search2 Where 0 = 0 "
                    
    'sql2 = " GROUP BY PAYCode, MONTH(MBMValueDate), YEAR(MBMValueDate) "
    
    'If Len(Trim(StrAppend)) Then
        'sql = sql + StrAppend + sql2
    'Else
        'sql = sql + sql2
    'End If
    
    'rst2.Open sql, medixneptuneconn, adOpenForwardOnly, adLockBatchOptimistic
    
    Do
        Do Until rst2.EOF
                            
            With rst2
            
                Set Record = lstMBMInquiryList.listitems.Add(, , !PAYCode)
                Payor = !PAYCode
                
                If Len(!Month & "/" & !Year) Then
                    If Len(!Month) = 1 Then
                        Month = "0" & !Month
                        Record.SubItems(1) = !Year & "/" & Month
                        Month = Month
                        Year = !Year
                    Else
                        Record.SubItems(1) = !Year & "/" & !Month
                        Month = !Month
                        Year = !Year
                    End If
                End If
                                
                If Len(rst2!TotalP) Then
                   Record.SubItems(2) = rst2!TotalP
                End If
                
                If Len(rst2!MCOGross) Then
                   Record.SubItems(4) = Format(rst2!MCOGross, "#,##0.00")
                Else
                   Record.SubItems(4) = "0.00"
                End If
                
                If Len(rst2!PremiumGross) Then
                   Record.SubItems(5) = Format(rst2!PremiumGross, "#,##0.00")
                Else
                   Record.SubItems(5) = "0.00"
                End If
                
                If Len(rst2!EAFee) Then
                   Record.SubItems(8) = Format(rst2!EAFee, "#,##0.00")
                Else
                   Record.SubItems(8) = "0.00"
                End If
                
                If Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountSuppRegMonthPayor(strAppend)
                End If
                
                If Len(TotalS) Then
                   Record.SubItems(3) = TotalS
                End If
                
                If Len(TotalSMCO) Then
                   Record.SubItems(6) = Format(TotalSMCO, "#,##0.00")
                Else
                   Record.SubItems(6) = "0.00"
                End If
                
                If Len(TotalSPrem) Then
                   Record.SubItems(7) = Format(TotalSPrem, "#,##0.00")
                Else
                   Record.SubItems(7) = "0.00"
                End If
                                
                TotalP = TotalP + rst2!TotalP
                lblTotalPrincipalCount = TotalP
                
                TotalS1 = TotalS1 + CDbl(TotalS)
                lbltotalSuppCount = TotalS1
                
                If Len(rst2!MCOGross) Then
                    TotalMCO = TotalMCO + rst2!MCOGross + TotalSMCO
                End If
                LblMCO = Format(TotalMCO, "#,##0.00")
                
                If Len(rst2!PremiumGross) Then
                    TotalPrem = TotalPrem + rst2!PremiumGross + TotalSPrem
                End If
                LblPrem = Format(TotalPrem, "#,##0.00")
                
                If Len(rst2!EAFee) Then
                    TotalAccess = TotalAccess + rst2!EAFee
                End If
                LblAccess = Format(TotalAccess, "#,##0.00")
                
                Total = CDbl(TotalP) + CDbl(TotalS1)
                lblCurrent = Total
                
            End With
            rst2.MoveNext
            DoEvents
        
            If intExit = 1 Then
                Check = False
                Exit Do
            End If
            Loop
    Loop Until Check = False
    intExit = 0
    
    If lstMBMInquiryList.listitems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdClear.Enabled = True
        cmdExit.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    rst2.Close
    Set rst2 = Nothing
    CmdClear.Enabled = True
    cmdExit.Enabled = True
    CmdPrintFile.Enabled = True

ElseIf Mid(ChkStr(CboMbmType), 1, 1) = "S" Then

    strAppendCase = "126"
            
    Set cmd.ActiveConnection = medixneptuneconn
    cmd.CommandText = "MBMTrackingSimple"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 300
    Set Prm1 = cmd.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, strAppend)
    cmd.Parameters.Append Prm1
    Set Prm2 = cmd.CreateParameter("strAppendCase", adVarChar, adParamInput, 255, strAppendCase)
    cmd.Parameters.Append Prm2
    rst2.CursorLocation = adUseClient
    rst2.CursorType = adOpenForwardOnly
    rst2.CacheSize = 100
    Set rst2 = cmd.Execute
    
    'sql = " SELECT PAYCode, MONTH(MBMValueDate) AS Month, " & _
          " YEAR(MBMValueDate) AS Year, COUNT(MBMNumber) AS TotalS, " & _
