          " SUM(MBMPayorPremGross) AS MBMPayorPremGross, SUM(MBMPayorPremNet) AS MBMPayorPremNet " & _
          " From VIEW_MBM_Supplementary2 Where 0 = 0 "
           
    'sql2 = " GROUP BY PAYCode ORDER BY PAYCode "
    
    'sql3 = " AND PAYCode = '" & Trim(Payor) & "'"
    
         
    'If Len(Trim(StrAppend)) Then
        'sql = sql + StrAppend + sql3 + sql2
    'Else
        'sql = sql + sql3 + sql2
    'End If
    
    'rst3.Open sql, medixneptuneconn, adOpenForwardOnly, adLockBatchOptimistic
    
        TotalSMCO = IIf(IsNumeric(rst3!MBMMCOFee) = True, rst3!MBMMCOFee, 0)
        TotalSBasicMCO = IIf(IsNumeric(rst3!MBMBasicMCO) = True, rst3!MBMBasicMCO, 0)
