Private Sub CboDepartment_Click()
Dim PAYGRP As New ADODB.Recordset
Dim cmd As New ADODB.Command
Dim Prm1 As New ADODB.Parameter
Dim Prm2 As New ADODB.Parameter
Dim strsql As String
Dim strAppendCase As String

If ChkGrpCom2.value = 1 Then
    
   ' medixneptuneconn.Open "File Name=" & BOSPath & "Conn\medineptuneconnect.UDL"
    
    CboGrpCom.Clear
    
    strAppendCase = "1"
    
    strsql = "AND PAYCode= '" & Mid(cboPayorCode, 1, 2) & "'"
    
    Set cmd.ActiveConnection = medixneptuneconn
    cmd.CommandText = "SearchComboListing"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 300
    Set Prm1 = cmd.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, strsql)
    cmd.Parameters.Append Prm1
    Set Prm2 = cmd.CreateParameter("Selection", adVarChar, adParamInput, 255, strAppendCase)
    cmd.Parameters.Append Prm2
    PAYGRP.CursorLocation = adUseClient
    PAYGRP.CursorType = adOpenForwardOnly
    PAYGRP.CacheSize = 100
    Set PAYGRP = cmd.Execute
    
    Do Until PAYGRP.EOF
        With PAYGRP
            CboGrpCom.AddItem Trim(PAYGRP!MBMGroupCompany)
            PAYGRP.MoveNext
        End With
    Loop
    PAYGRP.Close
    Set PAYGRP = Nothing
    
  '  medixneptuneconn.Close
  '  Set medixneptuneconn = Nothing
    
End If
End Sub

Private Sub CboDepartment_Change()
    If InStr(CboDepartment.Text, "null") Then
       CboDepartment.Enabled = False
    End If
End Sub

Private Sub CboDepartment_KeyPress(KeyAscii As Integer)
Dim NewText As String
Dim ValidCount As Integer
Dim ValidValue As String
Dim i As Integer
    If KeyAscii >= 32 And KeyAscii <> 127 Then
    NewText = LCase(Left(CboDepartment.Text, CboDepartment.SelStart) + Chr(KeyAscii) + Mid(CboDepartment.Text, CboDepartment.SelStart + CboDepartment.SelLength + 1))
 
    ValidCount = 0
    ValidValue = ""
 
    For i = 0 To CboDepartment.ListCount - 1
 
        If NewText = LCase(Left(CboGrpCom.List(i), Len(NewText))) Then
                ValidCount = ValidCount + 1
                ValidValue = CboDepartment.List(i)
        End If
        Next
        If ValidCount <= 1 Then KeyAscii = 0
            If ValidCount = 1 Then
                CboDepartment.Text = ValidValue
                CboDepartment.SelStart = 0
                CboDepartment.SelLength = Len(ValidValue)
            End If
        End If
End Sub

Private Sub CboGrpCom_Click()
Dim Dept As New ADODB.Recordset
Dim cmd As New ADODB.Command
Dim Prm1 As New ADODB.Parameter
Dim Prm2 As New ADODB.Parameter
Dim strsql As String
Dim strAppendCase As String

If ChkDepartment2.value = 1 Then
    
   ' medixneptuneconn.Open "File Name=" & BOSPath & "Conn\medineptuneconnect.UDL"
    
    CboDepartment.Clear
    
    strAppendCase = "4"
    
    strsql = "AND MBMGroupCompany = '" & RemStr(CboGrpCom) & "'"
    
    Set cmd.ActiveConnection = medixneptuneconn
    cmd.CommandText = "SearchComboListing"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 300
    Set Prm1 = cmd.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, strsql)
    cmd.Parameters.Append Prm1
    Set Prm2 = cmd.CreateParameter("Selection", adVarChar, adParamInput, 255, strAppendCase)
    cmd.Parameters.Append Prm2
    Dept.CursorLocation = adUseClient
    Dept.CursorType = adOpenForwardOnly
    Dept.CacheSize = 100
    Set Dept = cmd.Execute
    
    Do Until Dept.EOF
        With Dept
            CboDepartment.AddItem Trim(Dept!MBMDepartment)
            Dept.MoveNext
        End With
    Loop
    Dept.Close
    Set Dept = Nothing
    
    'medixneptuneconn.Close
    'Set medixneptuneconn = Nothing

Else
    CboDepartment.Clear

End If
End Sub

