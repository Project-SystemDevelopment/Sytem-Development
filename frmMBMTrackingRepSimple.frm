Private Sub ComboListing()
Dim state As New ADODB.Recordset
Dim Product As New ADODB.Recordset
Dim cmd As New ADODB.Command
Dim cmd2 As New ADODB.Command
    
    CboState.Clear
    Set cmd.ActiveConnection = medixneptuneconn
    cmd.CommandText = "SearchState"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 300
    state.CursorLocation = adUseClient
    state.CursorType = adOpenForwardOnly
    state.CacheSize = 100
    Set state = cmd.Execute
    
    Do Until state.EOF
        With state
            CboState.AddItem ChkStr(state!STADescription)
            state.MoveNext
        End With
    Loop
    state.Close
    Set state = Nothing
    
    CboProductCat.Clear
    Set cmd2.ActiveConnection = medixmasterconnMaint
    cmd2.CommandText = "SearchProductCategory"
    cmd2.CommandType = adCmdStoredProc
    cmd2.CommandTimeout = 300
    Product.CursorLocation = adUseClient
    Product.CursorType = adOpenForwardOnly
    Product.CacheSize = 100
    Set Product = cmd2.Execute
    
    Do Until Product.EOF
        With Product
            CboProductCat.AddItem !ProductCode & " - " & !ProductName
            Product.MoveNext
        End With
    Loop
    Product.Close
    Set Product = Nothing
    
    CboRel.AddItem "D - Daughter"
    CboRel.AddItem "H - Husband"
    CboRel.AddItem "S - Son"
    CboRel.AddItem "W - Wife"
    
    CboMbmType.AddItem "Both"
    CboMbmType.AddItem "P - Principal"
    CboMbmType.AddItem "S - Supplementary"
    CboMbmType.Text = "P - Principal"
    
    cboPrincipalType.AddItem "Both"
    cboPrincipalType.AddItem "C - Combined Limit"
    cboPrincipalType.AddItem "S - Separated Limit"
    cboPrincipalType.Text = "Both"
    
    cboHLTCode.AddItem "S - Sihat"
    cboHLTCode.AddItem "N - Non-Sihat"
    
    CboSex.AddItem "M - Male"
    CboSex.AddItem "F - Female"
    
    CboExpired.AddItem "N - No"
    CboExpired.AddItem "Y - Yes"
    
    cboDataStatus.AddItem "A - Active"
    cboDataStatus.AddItem "D - Delete"
    
    CboStatus.AddItem "0 - Active"
    CboStatus.AddItem "1 - Cancel"
    CboStatus.AddItem "2 - Delete"
    CboStatus.AddItem "3 - Active & Cancel"
    CboStatus.AddItem "4 - Active & Suspended"
    CboStatus.AddItem "5 - Active & Suspended & Cancel"
    CboStatus.AddItem "6 - Suspended"
        
    CboRace.AddItem "C - Chinese"
    CboRace.AddItem "I - Indian"
    CboRace.AddItem "M - Malay"
    CboRace.AddItem "O - Other"
        
    CboAdultChild.AddItem "A - Adult"
