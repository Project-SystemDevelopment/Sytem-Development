                End If
                
                If Len(!MBMPremium) Then
                   Record.SubItems(5) = Format(!MBMPremium, "#,##0.00")
                Else
                   Record.SubItems(5) = "0.00"
                End If
                
                If Len(!MBMBasicPrem) Then
                   Record.SubItems(6) = Format(!MBMBasicPrem, "#,##0.00")
                Else
                   Record.SubItems(6) = "0.00"
                End If
                
                If Len(!MBMPayorPremGross) Then
                   Record.SubItems(7) = Format(!MBMPayorPremGross, "#,##0.00")
                Else
                   Record.SubItems(7) = "0.00"
                End If
                
