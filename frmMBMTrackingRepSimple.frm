         If Trim(Mid(cboINSCode, 1, 1)) = "0" Then
            strCriteria = strCriteria & " AND  INSCode = 'I' "
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "1" Then
            strCriteria = strCriteria & " AND  INSCode = 'F' "
