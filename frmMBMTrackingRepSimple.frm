Private Function SearchRecord()
Dim strAppend As String
     
     strAppend = ""
     GrpCompany = ""

      If Len(Mid(cboHLTCode, 1, 1)) Then
          strAppend = strAppend & "AND HLTCode= '" & Mid(cboHLTCode, 1, 1) & "' "
      End If
      If ChkHltType.value = 1 Then
          strAppend = strAppend & " AND (HLTCode IS NULL OR HLTCode = '')"
      End If
      If ChkPayor.value = 1 Then
          strAppend = strAppend & " AND (PAYCode IS NULL OR PAYCode = '')"
      End If
      
      If Len(Trim(Mid(cboINSCode, 1, 1))) Then
         If Trim(Mid(cboINSCode, 1, 1)) = "0" Then
            strAppend = strAppend & " AND  INSCode = 'I' "
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "1" Then
            strAppend = strAppend & " AND  INSCode = 'F' "
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "2" Then
            strAppend = strAppend & " AND  INSCode = 'G' "
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "3" Then
            strAppend = strAppend & " AND  INSCode = 'H' "
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "4" Then
            strAppend = strAppend & " And (INSCode = 'I' OR INSCode = 'F')"
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "5" Then
            strAppend = strAppend & " And (INSCode = 'I' OR INSCode = 'G')"
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "6" Then
            strAppend = strAppend & " And (INSCode = 'F' OR INSCode = 'H')"
         ElseIf Trim(Mid(cboINSCode, 1, 1)) = "7" Then
            strAppend = strAppend & " And (INSCode = 'G' OR INSCode = 'H')"
         End If
      End If
      
      If ChkInsType.value = 1 Then
          strAppend = strAppend & " AND (INSCode IS NULL OR INSCode = '')"
      End If
            
      If CboReportType.ListIndex = 7 And CboRptSelection.Text = "General Listing (Prin. Name)" Then
      
        If Trim(Mid(CboMbmType, 1, 1)) = "P" And Trim(cboPrincipalType) = "Both" Then
           strAppend = strAppend & " AND (MBMMemberType = 'P' or  MBMMemberType = 'Q') AND MBMCovID = '00'"
        ElseIf Trim(Mid(CboMbmType, 1, 1)) = "P" And Trim(Mid(cboPrincipalType, 1, 1)) = "C" Then
           strAppend = strAppend & " AND MBMMemberType = 'P' AND MBMCOVID = '00'"
        ElseIf Trim(Mid(CboMbmType, 1, 1)) = "P" And Trim(Mid(cboPrincipalType, 1, 1)) = "S" Then
           strAppend = strAppend & " AND MBMMemberType = 'Q' AND MBMCOVID = '00'"
