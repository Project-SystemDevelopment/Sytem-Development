                Call ICListing
            ElseIf CboReportType.ListIndex = 2 And CboRptSelection.Text = "Details Listing" Then
                Call BordxDateListing
            ElseIf CboReportType.ListIndex = 14 And CboRptSelection.Text = "General Listing" Then
