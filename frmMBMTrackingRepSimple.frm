Private Sub InvoicePremiumSum(Optional strAppend As String)
Dim rst2 As New ADODB.Recordset
Dim rst3 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim sql3 As String
Dim sql4 As String
Dim cmd As New ADODB.Command
Dim Prm1 As New ADODB.Parameter
Dim Prm2 As New ADODB.Parameter
Dim strAppendCase As String

Total = 0
TotalIC = 0
TotalIA = 0
TotalF = 0
TotalFS = 0
TotalGC = 0
TotalGA = 0
TotalH = 0
TotalHS = 0
TotalICPremium = 0
TotalIAPremium = 0
TotalFPremium = 0
TotalFSPremium = 0
TotalGCPremium = 0
TotalGAPremium = 0
TotalHPremium = 0
TotalHSPremium = 0
TotalPrem = 0

Payor = ""
Invoice = ""
InvDate = ""
    
lstMBMInquiryList.listitems.Clear

If Mid(ChkStr(CboMbmType), 1, 1) = "P" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
        
    strAppendCase = "130"
            
    Set cmd.ActiveConnection = medixneptuneconn
    cmd.CommandText = "MBMTrackingSimple"
    cmd.CommandType = adCmdStoredProc
    cmd.CommandTimeout = 300
    Set Prm1 = cmd.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, strAppend)
    cmd.Parameters.Append Prm1
    Set Prm2 = cmd.CreateParameter("strAppendCase", adVarChar, adParamInput, 255, strAppendCase)
    cmd.Parameters.Append Prm2
    rst2.CursorLocation = adUseClient
    rst2.CursorType = adOpenForwardOnly
    rst2.CacheSize = 100
    Set rst2 = cmd.Execute
    
    'sql = " SELECT PAYCode, MBMInvoiceNo, MBMInvoiceDate From VIEW_MBM_Search2 Where 0 = 0 "
    
    'sql2 = " GROUP BY PAYCode, MBMInvoiceNo, MBMInvoiceDate ORDER BY PAYCode "
    
    'If Len(Trim(StrAppend)) Then
        'sql = sql + StrAppend + sql2
    'Else
        'sql = sql + sql2
    'End If
    
    'rst2.Open sql, medixneptuneconn, adOpenForwardOnly, adLockBatchOptimistic
        
    Do
        Do Until rst2.EOF
                        
            With rst2
    
                Set Record = lstMBMInquiryList.listitems.Add(, , rst2!PAYCode)
                Payor = rst2!PAYCode
                                
                If Len(rst2!MBMInvoiceNO) Then
                   Record.SubItems(1) = Trim(rst2!MBMInvoiceNO)
                   Invoice = Trim(rst2!MBMInvoiceNO)
                ElseIf rst2!MBMInvoiceNO = "" Then
                    Record.SubItems(1) = "Empty"
                    Invoice = ""
                Else
                    Record.SubItems(1) = "Empty"
                    Invoice = "NULL"
                End If
                             
                If Len(rst2!MBMInvoiceDate) Then
                   Record.SubItems(2) = Format(rst2!MBMInvoiceDate, "dd/mm/yyyy")
                   InvDate = Trim(rst2!MBMInvoiceDate)
                ElseIf rst2!MBMInvoiceDate = Null Then
                    Record.SubItems(2) = "Empty"
                    InvDate = ""
                Else
                    Record.SubItems(2) = "Empty"
                    InvDate = "NULL"
                End If
                
                Call CountICPremiumSum(strAppend)
                
                If Len(TotalICPremium) Then
                   Record.SubItems(3) = Format(TotalICPremium, "#,##0.00")
