Attribute VB_Name = "RptMBMInquiry"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsMBMInquiryList.State = 1 Then
       DataEnvironment1.rsMBMInquiryList.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(frmMBMEnquiry.ReportCriteria), "AND") = 0, "", Mid(Trim(frmMBMEnquiry.ReportCriteria), InStr(1, ChkStr(frmMBMEnquiry.ReportCriteria), "AND") + 3, Len(Trim(frmMBMEnquiry.ReportCriteria))))
       DataEnvironment1.rsMBMInquiryList.Filter = strsql
       DataEnvironment1.rsMBMInquiryList.Sort = "MBMName"
End Sub
