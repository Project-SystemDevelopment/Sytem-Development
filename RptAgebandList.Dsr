Private Sub DataReport_Initialize()
 
    
    'If Trim(frmMaintenanceOthers.AGECriteria) <> "" Then
            If DataEnvironment1.rsAgeList.State = 1 Then
                DataEnvironment1.rsAgeList.Requery
            End If
            strsql = IIf(InStr(1, ChkStr(frmMaintenanceOthers.AGECriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceOthers.AGECriteria), InStr(1, ChkStr(frmMaintenanceOthers.AGECriteria), "AND") + 3, Len(Trim(frmMaintenanceOthers.AGECriteria))))
            DataEnvironment1.rsAgeList.Filter = strsql
        'Loop
    'End If
 
    DataEnvironment1.rsAgeList.Sort = "AGECode"
        
End Sub


    
