Attribute VB_Name = "RptAgentList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsAgentList.state = 1 Then
       DataEnvironment1.rsAgentList.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(frmSuspensionDetail.AGTCriteria), "AND") = 0, "", Mid(Trim(frmSuspensionDetail.AGTCriteria), InStr(1, ChkStr(frmSuspensionDetail.AGTCriteria), "AND") + 3, Len(Trim(frmSuspensionDetail.AGTCriteria))))
       DataEnvironment1.rsAgentList.Filter = strsql
       DataEnvironment1.rsAgentList.Sort = "AgentCode"
End Sub

