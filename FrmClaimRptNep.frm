                'If Len(rst2!CLMBTBGAmt) Then
                '    Record.SubItems(16) = Format(IIf(rst2!CLMBTBGAmt >= 0, rst2!CLMBTBGAmt, rst2!CLMBTBGAmt * -1), "#,##0.00")
                'Else
                '    Record.SubItems(16) = Format(0, "#,##0.00")
                'End If
                
                lblCurrent = lblCurrent + 1
                .MoveNext
            End With
       Loop
  
    If ListView2.ListItems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdPrint.Enabled = True
        CmdClear.Enabled = True
        cmdExit.Enabled = True
    End If
    
    rst2.Close
    Set rst2 = Nothing
    CmdPrint.Enabled = True
    CmdClear.Enabled = True
    cmdExit.Enabled = True
End Sub

