                    HOspitals = Replace(Hospital, "'", "''")
                    
                    If DoctorName = "" And HOspitals = "" Then
                    
                        strAppendCase = "113"
                        StrAppend1 = " AND (AttendDoctor = '' OR AttendDoctor IS NULL) AND " & _
