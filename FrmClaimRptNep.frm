'================ Admission / Discharge Year Listing ===========================
Private Sub YearListing(Optional strAppend As String)
Dim rst2 As New ADODB.Recordset
Dim cmd As New ADODB.Command
Dim prm1 As ADODB.Parameter
Dim prm2 As ADODB.Parameter
Dim strAppendCase As String
Dim Record As ListItem
       
    Payor = ""
    ListView2.ListItems.Clear
    lblCurrent = 0
    
     strAppendCase = "153"
     Set cmd.ActiveConnection = medixneptuneconnWS
        cmd.CommandText = "ClaimReport1"
        cmd.CommandType = adCmdStoredProc
        cmd.CommandTimeout = 300
        Set prm1 = cmd.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, strAppend)
        cmd.Parameters.Append prm1
        Set prm2 = cmd.CreateParameter("StrAppendCase", adVarChar, adParamInput, 2000, strAppendCase)
        cmd.Parameters.Append prm2
        rst2.CursorLocation = adUseClient
        rst2.CursorType = adOpenForwardOnly
        rst2.CacheSize = 100
        Set rst2 = cmd.Execute
        
        Do Until rst2.EOF
                    
            With rst2
                If Len(rst2!PAYCode) Then
                
                Set Record = ListView2.ListItems.Add(, , rst2!PAYCode)
                Payor = rst2!PAYCode
                
                If cboClaimCase = "Claim" And cboReportType = "Admission" And opt33 = True Or _
                   cboClaimCase = "Case" And cboReportType = "Admission" And opt33 = True Then
                    Call SearchAdmissionYearRecords(strAppend)
                ElseIf cboClaimCase = "Claim" And cboReportType = "Discharge" And opt33 = True Or _
                       cboClaimCase = "Case" And cboReportType = "Discharge" And opt33 = True Then
                    Call SearchDischargeYearRecords(strAppend)
                End If
                
                If Len(Total1) Then
                    Record.SubItems(1) = Total1
                End If
                                
                If Len(Total2) Then
                    Record.SubItems(2) = Total2
                End If
                
                If Len(Total3) Then
                    Record.SubItems(3) = Total3
                End If
                
                If Len(Total4) Then
                    Record.SubItems(4) = Total4
                End If
                                
                If Len(Total5) Then
                    Record.SubItems(5) = Total5
                End If
                
                If Len(Total6) Then
                    Record.SubItems(6) = Total6
                End If
                
                If Len(Total7) Then
                    Record.SubItems(7) = Total7
                End If
                
                If Len(Total8) Then
                    Record.SubItems(8) = Total8
                End If
                
                If Len(Total9) Then
                    Record.SubItems(9) = Total9
                End If
                
                If Len(Total10) Then
                    Record.SubItems(10) = Total10
                End If
                
                If Len(Total11) Then
                    Record.SubItems(11) = Total11
                End If
                
                If Len(Total12) Then
                    Record.SubItems(12) = Total12
                End If
                
                If Len(rst2!CLMBTBGAmt) Then
                    Record.SubItems(13) = Format(IIf(rst2!CLMBTBGAmt >= 0, rst2!CLMBTBGAmt, rst2!CLMBTBGAmt * -1), "#,##0.00")
                Else
                    Record.SubItems(13) = Format(0, "#,##0.00")
                End If
                End If
            End With
            lblCurrent = lblCurrent + 1
            rst2.MoveNext
        Loop
    rst2.Close
    Set rst2 = Nothing
    CmdPrint.Enabled = True
    CmdClear.Enabled = True
    cmdExit.Enabled = True
End Sub
