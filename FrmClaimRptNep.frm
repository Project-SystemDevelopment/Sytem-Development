Dim cmd As New ADODB.Command
Dim prm1 As ADODB.Parameter
Dim prm2 As ADODB.Parameter
Dim strAppendCase As String
Dim StrAppend1 As String
Dim Record As ListItem

    Days = 0
    Hospital = ""
    HOspitals = ""
    lblCurrent = 0
    ListView2.ListItems.Clear
        
    If cboClaimCase = "Claim" Then
        strAppendCase = "212"
    ElseIf cboClaimCase = "Case" Then
        strAppendCase = "213"
    End If
    
    Set cmd.ActiveConnection = medixneptuneconnWS
        cmd.CommandText = "ClaimReport1"
        cmd.CommandType = adCmdStoredProc
        cmd.CommandTimeout = 300
        Set prm1 = cmd.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, strAppend)
        cmd.Parameters.Append prm1
        Set prm2 = cmd.CreateParameter("StrAppendCase", adVarChar, adParamInput, 2000, strAppendCase)
        cmd.Parameters.Append prm2
        rst2.CursorLocation = adUseClient
        rst2.CursorType = adOpenForwardOnly
        rst2.CacheSize = 100
        Set rst2 = cmd.Execute

        Do Until rst2.EOF
                
            With rst2
                If Len(rst2!HosName) Then
                    Set Record = ListView2.ListItems.Add(, , rst2!HosName)
                    Hospital = Trim(rst2!HosName)
                Else
                    Set Record = ListView2.ListItems.Add(, , "Empty")
                    Hospital = ""
                End If
                
                If Len(rst2!TotalActual) Then
                    Record.SubItems(1) = Format(rst2!TotalActual, "#,##0.00")
                End If
                                
                If Len(rst2!total) Then
                    Record.SubItems(2) = rst2!total
                End If
                
                If cboClaimCase = "Claim" Then
                
                    If rst2!NoofDay = "0" Then
                        Record.SubItems(3) = "1"
                        Days = 1
                    ElseIf Len(rst2!NoofDay) Then
                        Record.SubItems(3) = rst2!NoofDay
                        Days = rst2!NoofDay
                    End If
                    
                ElseIf cboClaimCase = "Case" Then
                
                    HOspitals = Replace(Hospital, "'", "''")
                    
                    If HOspitals = "" Then
                    
                        strAppendCase = "214"
                        StrAppend1 = " AND HOSName = '' OR HOSName IS NULL"
                        StrAppend1 = StrAppend1 + strAppend
                              
                    ElseIf HOspitals <> "" Then
                    
                        strAppendCase = "214"
                        StrAppend1 = " AND HOSName = '" & Trim(HOspitals) & "'"
                        StrAppend1 = StrAppend1 + strAppend
                                                            
                    End If
                    Call DurationStay(StrAppend1, strAppendCase, Record)
                
                End If
                
                If Len(rst2!total) Then
                   Record.SubItems(4) = Format(Round(rst2!TotalActual / rst2!total, 0), "#,##0.00")
                End If
                
                If Days <> 0 Then
                    Record.SubItems(5) = Format(Round(rst2!TotalActual / Days, 0), "#,##0.00")
                    Record.SubItems(6) = Format(Days / rst2!total, 0)
                Else
                    Record.SubItems(5) = Format(Round(rst2!TotalActual / 1, 0), "#,##0.00")
                    Record.SubItems(6) = Format(1 / rst2!total, 0)
                End If
                
                If Len(rst2!CLMBTBGAmt) Then
                    Record.SubItems(7) = Format(IIf(rst2!CLMBTBGAmt >= 0, rst2!CLMBTBGAmt, rst2!CLMBTBGAmt * -1), "#,##0.00")
                Else
                    Record.SubItems(7) = Format(0, "#,##0.00")
                End If
                           
            End With
            lblCurrent = lblCurrent + 1
            rst2.MoveNext
        Loop
    If ListView2.ListItems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdPrint.Enabled = True
        CmdClear.Enabled = True
        cmdExit.Enabled = True
    End If
    rst2.Close
    Set rst2 = Nothing
    CmdPrint.Enabled = True
    CmdClear.Enabled = True
    cmdExit.Enabled = True
End Sub

