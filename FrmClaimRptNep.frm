    End If
    
    If Len(Trim(TxtPatientName)) Then
       strAppend = strAppend + " And  PatientName like '%" & ChkStr(TxtPatientName) & "%' "
    End If
    
    If Len(Trim(TxtBranch)) Then
       strAppend = strAppend + " And  BRNCode = '" & ChkStr(TxtBranch) & "'"
