Set cnn.ActiveConnection = medixneptuneconnWS
    cnn.CommandText = "ClaimReport1"
    cnn.CommandType = adCmdStoredProc
    cnn.CommandTimeout = 300
    Set prm1 = cnn.CreateParameter("StrAppend", adVarChar, adParamInput, 2000, StrAppend1)
    cnn.Parameters.Append prm1
    Set prm2 = cnn.CreateParameter("StrAppendCase", adVarChar, adParamInput, 2000, 200)
    cnn.Parameters.Append prm2
