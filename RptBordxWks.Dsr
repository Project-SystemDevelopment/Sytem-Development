Attribute VB_Name = "RptBordxWks"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
 
    If DataEnvironment2.rsBordxWksList.State = 1 Then
       DataEnvironment2.rsBordxWksList.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(FrmBordxTracking.searchCriteria), "AND") = 0, "", Mid(Trim(FrmBordxTracking.searchCriteria), InStr(1, ChkStr(FrmBordxTracking.searchCriteria), "AND") + 3, Len(Trim(FrmBordxTracking.searchCriteria))))
       DataEnvironment2.rsBordxWksList.Filter = strsql
       DataEnvironment2.rsBordxWksList.Sort = "PAYCode"
        
End Sub
