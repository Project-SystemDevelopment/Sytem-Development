Private Sub DataReport_Initialize()
Dim strsql As String
    
    If DataEnvironment3.rsReceiptMNRBTracking.State = 1 Then
       DataEnvironment3.rsReceiptMNRBTracking.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(FrmReceiptTracking.ReceiptTrackingCriteria), "AND") = 0, "", Mid(Trim(FrmReceiptTracking.ReceiptTrackingCriteria), InStr(1, ChkStr(FrmReceiptTracking.ReceiptTrackingCriteria), "AND") + 3, Len(Trim(FrmReceiptTracking.ReceiptTrackingCriteria))))
       DataEnvironment3.rsReceiptMNRBTracking.Filter = strsql
       DataEnvironment3.rsReceiptMNRBTracking.Sort = "ReceiptNo"
End Sub

