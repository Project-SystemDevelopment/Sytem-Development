Private Sub DataReport_Initialize()
    
    If DataEnvironment4.rsCtyList.state = 1 Then
       DataEnvironment4.rsCtyList.Requery
    End If
       strsql = IIf(InStr(1, ChkStr(frmMaintenanceOthers.CTYCriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceOthers.CTYCriteria), InStr(1, ChkStr(frmMaintenanceOthers.CTYCriteria), "AND") + 3, Len(Trim(frmMaintenanceOthers.CTYCriteria))))
       DataEnvironment4.rsCtyList.Filter = strsql
       DataEnvironment4.rsCtyList.Sort = "CTYCOde"
       
End Sub


