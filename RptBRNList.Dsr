Attribute VB_Name = "RptBRNList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()

    If DataEnvironment1.rsPayBrnList.State = 1 Then
       DataEnvironment1.rsPayBrnList.Requery
    End If

       strsql = IIf(InStr(1, ChkStr(frmMaintenanceGeneral.BRNCriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceGeneral.BRNCriteria), InStr(1, ChkStr(frmMaintenanceGeneral.BRNCriteria), "AND") + 3, Len(Trim(frmMaintenanceGeneral.BRNCriteria))))
       DataEnvironment1.rsPayBrnList.Filter = strsql
       DataEnvironment1.rsPayBrnList.Sort = "PAYCode"
End Sub
