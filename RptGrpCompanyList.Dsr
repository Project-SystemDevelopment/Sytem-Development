Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsCompanyGrpList.state = 1 Then
       DataEnvironment1.rsCompanyGrpList.Requery
    End If
       StrSql = IIf(InStr(1, ChkStr(frmMaintenanceGeneral.GRPCoCriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceGeneral.GRPCoCriteria), InStr(1, ChkStr(frmMaintenanceGeneral.GRPCoCriteria), "AND") + 3, Len(Trim(frmMaintenanceGeneral.GRPCoCriteria))))
       DataEnvironment1.rsCompanyGrpList.Filter = StrSql
       DataEnvironment1.rsCompanyGrpList.Sort = "CoGrpCode"
End Sub

